[Unit]
Description=Enable the managed Codex daemon and remote control

[Service]
Type=oneshot
WorkingDirectory=%h
Environment="PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
ExecStart=%h/.local/bin/codex remote-control start --json
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
# Codex owns its daemon/updater lifecycle; keep active chats on service stop.
KillMode=process

[Install]
WantedBy=default.target
