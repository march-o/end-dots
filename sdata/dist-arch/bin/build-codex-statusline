#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
source_dir=$(mktemp -d /tmp/codex-statusline.XXXXXXXX)
trap 'find "$source_dir" -depth -delete' EXIT

git clone --quiet --depth 1 --branch rust-v0.160.0 --filter=blob:none \
  https://github.com/openai/codex.git "$source_dir"
git -C "$source_dir" apply \
  "$repo_root/sdata/dist-arch/patches/codex-0.160.0-git-diff-statusline.patch"

target_dir="$HOME/.cache/codex-statusline-target"
systemd-run --user --scope -p MemoryMax=6G -p CPUQuota=200% \
  nice -n 10 env CARGO_TARGET_DIR="$target_dir" CARGO_BUILD_JOBS=2 \
  CARGO_PROFILE_DEV_DEBUG=0 CARGO_INCREMENTAL=0 \
  cargo build --manifest-path "$source_dir/codex-rs/Cargo.toml" \
  -p codex-cli --bin codex -j 2

install -Dm755 "$target_dir/debug/codex" "$HOME/.local/bin/codex-statusline-0.160.0"
strip -s "$HOME/.local/bin/codex-statusline-0.160.0"
ln -sfn "$HOME/.local/bin/codex-statusline-0.160.0" "$HOME/.local/bin/codex"
