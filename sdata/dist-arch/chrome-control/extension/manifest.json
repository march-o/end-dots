{
  "manifest_version": 3,
  "name": "Chrome Control",
  "version": "0.1.0",
  "description": "Local Chrome control for agents",
  "permissions": ["tabs", "windows", "scripting", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" }
}
