+
+/// Counts staged and unstaged changes to tracked files relative to HEAD.
+async fn worktree_diff_stats(
+    runner: &dyn WorkspaceCommandExecutor,
+    cwd: &Path,
+) -> Option<GitBranchDiffStats> {
+    let output = run_git_command(
+        runner,
+        cwd,
+        &["diff", "--no-ext-diff", "--shortstat", "HEAD"],
+    )
+    .await
+    .ok()?;
+    if !output.success() {
+        return None;
+    }
+
+    let mut additions = 0;
+    let mut deletions = 0;
+    for part in output.stdout.split(',') {
+        let mut words = part.split_whitespace();
+        let count = words
+            .next()
+            .and_then(|value| value.parse().ok())
+            .unwrap_or(0);
+        match words.next() {
+            Some("insertion(+)" | "insertions(+)") => additions = count,
+            Some("deletion(-)" | "deletions(-)") => deletions = count,
+            _ => {}
+        }
     }
+    Some(GitBranchDiffStats {
+        additions,
+        deletions,
+    })
 }
 
