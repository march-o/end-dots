+// Model labels may contain spaces; effort is a separate word before an optional service tier.
+fn reasoning_range(text: &str) -> Option<(usize, usize)> {
+    let mut offset = 0;
+    for word in text.split_inclusive(' ') {
+        let token = word.trim_end();
+        if offset > 0
+            && matches!(
+                token,
+                "default"
+                    | "minimal"
+                    | "low"
+                    | "medium"
+                    | "high"
+                    | "xhigh"
+                    | "max"
+                    | "ultra"
+                    | "persistent"
+            )
+        {
+            return Some((offset, offset + token.len()));
+        }
+        offset += word.len();
+    }
+    None
+}
+
+fn remaining_percent(item: StatusLineItem, text: &str) -> Option<u8> {
+    if !matches!(
+        item,
+        StatusLineItem::ContextRemaining
+            | StatusLineItem::ContextUsed
+            | StatusLineItem::FiveHourLimit
+            | StatusLineItem::WeeklyLimit
+    ) {
+        return None;
+    }
+    text.strip_suffix(" left")
+        .unwrap_or(text)
+        .strip_suffix('%')?
+        .split_whitespace()
+        .last()?
+        .parse::<u8>()
+        .ok()
+        .map(|percent| {
+            let percent = percent.min(100);
+            if item == StatusLineItem::ContextUsed || text.starts_with("WK: ") {
+                100 - percent
+            } else {
+                percent
+            }
+        })
+}
+
+fn remaining_color(percent: u8) -> Color {
+    let (start, end, position) = if percent < 50 {
+        ((220, 72, 72), (230, 190, 60), percent)
+    } else {
+        ((230, 190, 60), (72, 190, 104), percent - 50)
+    };
+    let blend = |from: u8, to: u8| {
+        (u16::from(from) * u16::from(50 - position) + u16::from(to) * u16::from(position)) / 50
+    };
+    Color::Rgb(
+        blend(start.0, end.0) as u8,
+        blend(start.1, end.1) as u8,
+        blend(start.2, end.2) as u8,
+    )
+}
