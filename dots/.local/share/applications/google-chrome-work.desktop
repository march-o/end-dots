[Desktop Entry]
Version=1.0
Type=Application
Name=Chrome Work
GenericName=Web Browser
Comment=Browse with the work Chrome profile
Exec=/home/martins/.local/bin/chrome-profile-launch work %U
Icon=google-chrome
Terminal=false
StartupNotify=true
StartupWMClass=google-chrome
Categories=Network;WebBrowser;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Work Window
Exec=/home/martins/.local/bin/chrome-profile-launch work --new-window

[Desktop Action new-private-window]
Name=New Work Incognito Window
Exec=/home/martins/.local/bin/chrome-profile-launch work --incognito --new-window
